@model Firma.Data.Data.Sklep.Zamowienie

@{
    ViewData["Title"] = "Szczegóły zamówienia";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Zamówienia</a></li>
        <li class="breadcrumb-item active" aria-current="page">Szczegóły</li>
    </ol>
</nav>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3">
    <div>
        <h2 class="mb-1">Zamówienie #@Model.IdZamowienie</h2>
        <p class="text-muted mb-0">@Model.Imie @Model.Nazwisko, @Model.Email</p>
    </div>
    <div class="btn-group" role="group">
        <a asp-controller="PozycjaZamowienia" asp-action="Index" asp-route-zamowienieId="@Model.IdZamowienie" class="btn btn-outline-info">
            <i class="bi bi-list-ul"></i>
            Pozycje
        </a>
        <a asp-controller="Platnosc" asp-action="Index" asp-route-zamowienieId="@Model.IdZamowienie" class="btn btn-outline-success">
            <i class="bi bi-credit-card"></i>
            Płatności
        </a>
    </div>
</div>

<div class="card bg-body-tertiary shadow mb-4">
    <div class="card-body">
        <h4>Dane zamówienia</h4>
        <hr />
        <dl class="row">
            <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Imie)</dt>
            <dd class="col-sm-10">@Html.DisplayFor(model => model.Imie)</dd>
            <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Nazwisko)</dt>
            <dd class="col-sm-10">@Html.DisplayFor(model => model.Nazwisko)</dd>
            <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Email)</dt>
            <dd class="col-sm-10">@Html.DisplayFor(model => model.Email)</dd>
            <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Miejscowosc)</dt>
            <dd class="col-sm-10">@Html.DisplayFor(model => model.Miejscowosc)</dd>
            <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Ulica)</dt>
            <dd class="col-sm-10">@Html.DisplayFor(model => model.Ulica)</dd>
            <dt class="col-sm-2">@Html.DisplayNameFor(model => model.NumerBudynku)</dt>
            <dd class="col-sm-10">@Html.DisplayFor(model => model.NumerBudynku)</dd>
            <dt class="col-sm-2">@Html.DisplayNameFor(model => model.KodPocztowy)</dt>
            <dd class="col-sm-10">@Html.DisplayFor(model => model.KodPocztowy)</dd>
            <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Suma)</dt>
            <dd class="col-sm-10">@Html.DisplayFor(model => model.Suma)</dd>
            <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Status)</dt>
            <dd class="col-sm-10"><span class="badge bg-secondary">@Html.DisplayFor(model => model.Status)</span></dd>
            <dt class="col-sm-2">@Html.DisplayNameFor(model => model.DataZamowienia)</dt>
            <dd class="col-sm-10">@Html.DisplayFor(model => model.DataZamowienia)</dd>
        </dl>
    </div>
</div>

<div class="row g-4">
    <div class="col-12 col-xl-7">
        <div class="card bg-body-tertiary shadow h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="mb-0">Pozycje zamówienia</h4>
                    <a asp-controller="PozycjaZamowienia" asp-action="Create" asp-route-zamowienieId="@Model.IdZamowienie" class="btn btn-success btn-sm">
                        <i class="bi bi-plus-lg"></i>
                        Dodaj
                    </a>
                </div>

                @if (!Model.Pozycje.Any())
                {
                    <p class="text-muted mb-0">Brak pozycji dla tego zamówienia.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Towar</th>
                                    <th>Ilość</th>
                                    <th>Cena</th>
                                    <th>Wartość</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var pozycja in Model.Pozycje)
                                {
                                    <tr>
                                        <td>@pozycja.Towar?.Nazwa</td>
                                        <td>@pozycja.Ilosc</td>
                                        <td>@pozycja.Cena.ToString("0.00") zł</td>
                                        <td class="fw-semibold">@((pozycja.Ilosc * pozycja.Cena).ToString("0.00")) zł</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-5">
        <div class="card bg-body-tertiary shadow h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="mb-0">Płatności</h4>
                    <a asp-controller="Platnosc" asp-action="Create" asp-route-zamowienieId="@Model.IdZamowienie" class="btn btn-success btn-sm">
                        <i class="bi bi-plus-lg"></i>
                        Dodaj
                    </a>
                </div>

                @if (!Model.Platnosci.Any())
                {
                    <p class="text-muted mb-0">Brak płatności dla tego zamówienia.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Kwota</th>
                                    <th>Metoda</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var platnosc in Model.Platnosci)
                                {
                                    <tr>
                                        <td>@platnosc.Kwota.ToString("0.00") zł</td>
                                        <td>@platnosc.Metoda</td>
                                        <td><span class="badge bg-secondary">@platnosc.Status</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="mt-4">
    <a asp-action="Edit" asp-route-id="@Model.IdZamowienie" class="btn btn-outline-primary">
        <i class="bi bi-pencil"></i>
        Edytuj
    </a>
    <a asp-action="Index" class="btn btn-outline-secondary">Wróć do listy</a>
</div>
