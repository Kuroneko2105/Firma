                    <h5 class="card-title">Aktualności</h5>
                    <p class="card-text">Some quick example text to build on the card title and make up the bulk of the card’s content.</p>
                    <a href="#" class="btn btn-primary mt-auto">Dodaj aktualność</a>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6">
            <div class="card h-100 bg-body-tertiary text-body">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">Rodzaje</h5>
                    <p class="card-text">Some quick example text to build on the card title and make up the bulk of the card’s content.</p>
                    <a href="#" class="btn btn-primary mt-auto">Dodaj produkt</a>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6">
            <div class="card h-100 bg-body-tertiary text-body">
