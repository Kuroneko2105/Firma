@model Firma.Data.Data.CMS.Strona

@{
    ViewData["Title"] = "Details";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-12">
            <div class="card bg-body-tertiary shadow-sm">
                <div class="card-body">
                    <h2 class="card-title">@Model.Tytul</h2>
                    <p class="text-muted mb-2">Link: <strong>@Model.LinkTytul</strong></p>

                    <hr />

                    <h6>Treść</h6>
                    <p>@Model.Tresc</p>

                    <p class="text-muted">Pozycja: @Model.Pozycja</p>

                    <div class="d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.IdStrony" class="btn btn-primary d-flex align-items-center gap-2">
                            <i class="bi bi-pencil"></i> Edytuj
                        </a>
                        <a asp-action="Index" class="btn btn-outline-secondary d-flex align-items-center gap-2">
                            <i class="bi bi-arrow-left"></i> Powrót
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
