@model IEnumerable<Firma.Data.Data.Uzytkownicy.OpiniaKlienta>

@{
    ViewData["Title"] = "Opinie klientow";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
        <li class="breadcrumb-item active" aria-current="page">Opinie klientow</li>
    </ol>
</nav>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3">
    <div>
        <h2 class="mb-1">Opinie klientow</h2>
        <p class="text-muted mb-0">Zarzadzaj opiniami uzytkownikow.</p>
    </div>
    <a asp-action="Create" class="btn btn-success d-inline-flex align-items-center gap-2">
        <i class="bi bi-plus-lg"></i>
        Dodaj opinie
    </a>
</div>

<div class="card bg-body-tertiary shadow">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Autor</th>
                        <th>Produkt</th>
                        <th>Ocena</th>
                        <th>Status</th>
                        <th>Data</th>
                        <th class="text-end">Akcje</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@item.Imie</div>
                                <div class="text-muted small">@item.Email</div>
                            </td>
                            <td>@item.Towar?.Nazwa</td>
                            <td><span class="badge text-bg-warning">@item.Ocena / 5</span></td>
                            <td>
                                @if (item.CzyZatwierdzona)
                                {
                                    <span class="badge text-bg-success">Zatwierdzona</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">Robocza</span>
                                }
                            </td>
                            <td>@item.DataDodania.ToString("dd.MM.yyyy")</td>
                            <td class="text-end">
                                <div class="btn-group" role="group">
                                    <a asp-action="Edit" asp-route-id="@item.IdOpinii" class="btn btn-outline-primary btn-sm" title="Edytuj"><i class="bi bi-pencil"></i></a>
                                    <a asp-action="Details" asp-route-id="@item.IdOpinii" class="btn btn-outline-secondary btn-sm" title="Szczegoly"><i class="bi bi-eye"></i></a>
                                    <a asp-action="Delete" asp-route-id="@item.IdOpinii" class="btn btn-outline-danger btn-sm" title="Usun"><i class="bi bi-trash"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
