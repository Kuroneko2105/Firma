@model Firma.Data.Data.Uzytkownicy.OpiniaKlienta

<div class="row g-3">
    <div class="col-12">
        <label asp-for="TowarId" class="form-label"></label>
        <select asp-for="TowarId" class="form-select" asp-items="ViewBag.TowarId">
            <option value="">-- wybierz produkt --</option>
        </select>
        <span asp-validation-for="TowarId" class="text-danger"></span>
    </div>
    <div class="col-12 col-md-6">
        <label asp-for="Imie" class="form-label"></label>
        <input asp-for="Imie" class="form-control" />
        <span asp-validation-for="Imie" class="text-danger"></span>
    </div>
    <div class="col-12 col-md-6">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="col-12 col-md-4">
        <label asp-for="Ocena" class="form-label"></label>
        <input asp-for="Ocena" class="form-control" min="1" max="5" />
        <span asp-validation-for="Ocena" class="text-danger"></span>
    </div>
    <div class="col-12 col-md-8 d-flex align-items-end">
        <div class="form-check form-switch mb-2">
            <input asp-for="CzyZatwierdzona" class="form-check-input" />
            <label asp-for="CzyZatwierdzona" class="form-check-label"></label>
        </div>
    </div>
    <div class="col-12">
        <label asp-for="Tresc" class="form-label"></label>
        <textarea asp-for="Tresc" class="form-control" rows="5"></textarea>
        <span asp-validation-for="Tresc" class="text-danger"></span>
    </div>
</div>
