@model Firma.Data.Data.Uzytkownicy.OpiniaKlienta

@{
    ViewData["Title"] = "Edytuj opinie";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Opinie klientow</a></li>
        <li class="breadcrumb-item active" aria-current="page">Edycja</li>
    </ol>
</nav>

<div class="card bg-body-tertiary shadow">
    <div class="card-body">
        <h2 class="mb-3">Edytuj opinie</h2>
        <form asp-action="Edit">
            <input type="hidden" asp-for="IdOpinii" />
            <input type="hidden" asp-for="DataDodania" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <partial name="_Form" model="Model" />
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Zapisz zmiany</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Wroc do listy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
