@model IEnumerable<Firma.Data.Data.Sklep.Platnosc>

@{
    ViewData["Title"] = "Płatności";
    int? zamowienieId = ViewBag.ZamowienieId as int?;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/">Home</a></li>
        <li class="breadcrumb-item"><a asp-controller="Zamowienie" asp-action="Index">Zamówienia</a></li>
        <li class="breadcrumb-item active" aria-current="page">Płatności</li>
    </ol>
</nav>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-3">
    <div>
        <h2 class="mb-1">Płatności</h2>
        @if (zamowienieId != null)
        {
            <p class="text-muted mb-0">Filtrowanie dla zamówienia #@zamowienieId</p>
        }
    </div>
    @if (zamowienieId != null)
    {
        <a asp-controller="Zamowienie" asp-action="Details" asp-route-id="@zamowienieId" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i>
            Wróć do zamówienia
        </a>
    }
</div>

<p class="text-muted">
    Liczba płatności: <strong>@Model.Count()</strong>
</p>

<p>
    <a asp-action="Create" asp-route-zamowienieId="@zamowienieId" class="btn btn-success d-inline-flex align-items-center gap-2">
        <i class="bi bi-plus-lg"></i>
        Dodaj płatność
    </a>
</p>

<div class="card bg-body-tertiary shadow">
    <div class="card-body">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Kwota)</th>
                    <th>@Html.DisplayNameFor(model => model.Metoda)</th>
                    <th>@Html.DisplayNameFor(model => model.Status)</th>
                    <th>@Html.DisplayNameFor(model => model.DataPlatnosci)</th>
                    <th>Zamówienie</th>
                    <th class="text-end">Akcje</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Kwota.ToString("0.00") zł</td>
                        <td>@Html.DisplayFor(modelItem => item.Metoda)</td>
                        <td><span class="badge bg-secondary">@Html.DisplayFor(modelItem => item.Status)</span></td>
                        <td>@Html.DisplayFor(modelItem => item.DataPlatnosci)</td>
                        <td>
                            <a asp-controller="Zamowienie" asp-action="Details" asp-route-id="@item.ZamowienieId" class="text-decoration-none">
                                #@item.ZamowienieId - @item.Zamowienie?.Email
                            </a>
                        </td>
                        <td class="text-end">
                            <div class="btn-group" role="group">
                                <a asp-action="Edit" asp-route-id="@item.IdPlatnosc" class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Details" asp-route-id="@item.IdPlatnosc" class="btn btn-outline-secondary btn-sm">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.IdPlatnosc" class="btn btn-outline-danger btn-sm">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
