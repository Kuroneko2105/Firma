@model IEnumerable<Firma.Data.Data.CMS.Ogloszenie>

@{
    ViewData["Title"] = "Index";
}
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">Ogłoszenia</li>
        </ol>
    </nav>
    <h2>Ogłoszenia</h2>
    <p class="text-muted">
        Liczba ogłoszeń: <strong>@Model.Count()</strong>
    </p>
    <p>
        <a asp-action="Create" class="btn btn-success d-inline-flex align-items-center gap-2">
            <i class="bi bi-plus-lg"></i>
            Dodaj nowy
        </a>
    </p>
    <div class="card bg-body-tertiary shadow">
        <div class="card-body">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>
                            @Html.DisplayNameFor(model => model.LinkTytul)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Tytul)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Tresc)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.ZdjecieUrl)
                        </th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.LinkTytul)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Tytul)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Tresc)
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(item.ZdjecieUrl))
                                {
                                    var zdjecie = item.ZdjecieUrl;
                                    var imageSrc = zdjecie.StartsWith("http://", System.StringComparison.OrdinalIgnoreCase)
                                        || zdjecie.StartsWith("https://", System.StringComparison.OrdinalIgnoreCase)
                                        || zdjecie.StartsWith("/")
                                            ? zdjecie
                                            : Url.Content($"~/content/{zdjecie.TrimStart('~', '/')}");

                                    <a href="@imageSrc" target="_blank" rel="noopener noreferrer" class="d-inline-block text-break">
                                        @item.ZdjecieUrl
                                    </a>
                                    <div class="mt-1">
                                        <img src="@imageSrc" alt="@item.Tytul" style="max-height:60px; max-width:120px; object-fit:cover;" />
                                    </div>
                                }
                            </td>
                            <td>
                                <div class="btn-group" role="group" aria-label="Actions">
                                    <a asp-action="Edit" asp-route-id="@item.IdOgloszenia" class="btn btn-sm btn-outline-primary d-flex align-items-center gap-1">
                                        <i class="bi bi-pencil"></i>
                                        <span class="d-none d-sm-inline">Edit</span>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.IdOgloszenia" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1">
                                        <i class="bi bi-eye"></i>
                                        <span class="d-none d-sm-inline">Details</span>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.IdOgloszenia" class="btn btn-sm btn-outline-danger d-flex align-items-center gap-1">
                                        <i class="bi bi-trash"></i>
                                        <span class="d-none d-sm-inline">Delete</span>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

