@model IEnumerable<Firma.Data.Data.CMS.Ogloszenie>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create" class="btn btn-success d-inline-flex align-items-center gap-2">
        <i class="bi bi-plus-lg"></i>
        Dodaj nowy
    </a>
</p>
<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.LinkTytul)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Tytul)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Tresc)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.LinkTytul)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Tytul)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Tresc)
            </td>
            <td>
                <div class="btn-group" role="group" aria-label="Actions">
                    <a asp-action="Edit" asp-route-id="@item.IdOgloszenia" class="btn btn-sm btn-outline-primary d-flex align-items-center gap-1">
                        <i class="bi bi-pencil"></i>
                        <span class="d-none d-sm-inline">Edit</span>
                    </a>
                    <a asp-action="Details" asp-route-id="@item.IdOgloszenia" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1">
                        <i class="bi bi-eye"></i>
                        <span class="d-none d-sm-inline">Details</span>
                    </a>
                    <a asp-action="Delete" asp-route-id="@item.IdOgloszenia" class="btn btn-sm btn-outline-danger d-flex align-items-center gap-1">
                        <i class="bi bi-trash"></i>
                        <span class="d-none d-sm-inline">Delete</span>
                    </a>
                </div>
            </td>
        </tr>
}
    </tbody>
</table>
