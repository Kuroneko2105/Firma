@model Firma.Data.Data.CMS.Ogloszenie

@{
    ViewData["Title"] = "Details";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8">
            <div class="card bg-body-tertiary shadow-sm">
                <div class="card-body">
                    <h2 class="card-title">@Model.Tytul</h2>
                    <p class="text-muted mb-2">Link: <strong>@Model.LinkTytul</strong></p>

                    <hr />

                    <h6>Treść</h6>
                    <p>@Model.Tresc</p>

                    @if (!string.IsNullOrWhiteSpace(Model.ZdjecieUrl))
                    {
                        var zdjecie = Model.ZdjecieUrl;
                        var imageSrc = zdjecie.StartsWith("http://", System.StringComparison.OrdinalIgnoreCase)
                            || zdjecie.StartsWith("https://", System.StringComparison.OrdinalIgnoreCase)
                            || zdjecie.StartsWith("/")
                                ? zdjecie
                                : Url.Content($"~/content/{zdjecie.TrimStart('~', '/')}");

                        <h6>Zdjęcie</h6>
                        <p class="text-break">@Model.ZdjecieUrl</p>
                        <img src="@imageSrc" alt="@Model.Tytul" class="img-fluid rounded mb-3" style="max-height:360px; object-fit:cover;" />
                    }

                    <div class="d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.IdOgloszenia" class="btn btn-primary d-flex align-items-center gap-2">
                            <i class="bi bi-pencil"></i> Edytuj
                        </a>
                        <a asp-action="Index" class="btn btn-outline-secondary d-flex align-items-center gap-2">
                            <i class="bi bi-arrow-left"></i> Powrót
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
