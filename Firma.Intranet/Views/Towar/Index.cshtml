@model IEnumerable<Firma.Data.Data.Sklep.Towar>

@{
    ViewData["Title"] = "Index";
}
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">Towary</li>
        </ol>
    </nav>
    <h2>Towary</h2>
    <p class="text-muted">
        Liczba towarów: <strong>@Model.Count()</strong>
    </p>
    <p>
        <a asp-action="Create" class="btn btn-success d-inline-flex align-items-center gap-2">
            <i class="bi bi-plus-lg"></i>
            Dodaj nowy
        </a>
    </p>
    <div class="card bg-body-tertiary shadow">
        <div class="card-body">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>
                            @Html.DisplayNameFor(model => model.Kod)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Nazwa)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Cena)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.FotoUrl)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Opis)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Rodzaj)
                        </th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.Kod)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Nazwa)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Cena)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.FotoUrl)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Opis)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Rodzaj.Nazwa)
                            </td>
                            <td>
                                <div class="btn-group" role="group" aria-label="Actions">
                                    <a asp-action="Edit" asp-route-id="@item.IdTowaru" class="btn btn-sm btn-outline-primary d-flex align-items-center gap-1">
                                        <i class="bi bi-pencil"></i>
                                        <span class="d-none d-sm-inline">Edit</span>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.IdTowaru" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1">
                                        <i class="bi bi-eye"></i>
                                        <span class="d-none d-sm-inline">Details</span>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.IdTowaru" class="btn btn-sm btn-outline-danger d-flex align-items-center gap-1">
                                        <i class="bi bi-trash"></i>
                                        <span class="d-none d-sm-inline">Delete</span>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
