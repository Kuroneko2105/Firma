@model IEnumerable<Firma.Data.Data.CMS.Aktualnosc>
@{
    ViewData["Title"] = "Aktualnosci";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4 px-4">
    <h3 class="mb-4 text-center">Aktualnosci</h3>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-12">
                    <div class="card bg-body-tertiary h-100">
                        <div class="row g-0 h-100">
                            <div class="col-12 col-md-4 d-flex align-items-center justify-content-center">
                                @if (!string.IsNullOrWhiteSpace(item.ZdjecieUrl))
                                {
                                    <img src="~/content/@item.ZdjecieUrl" class="img-fluid rounded-start w-100 h-100" alt="@item.Tytul" style="max-height:420px; object-fit:cover;" />
                                }
                                else
                                {
                                    <div class="bg-secondary text-white d-flex align-items-center justify-content-center w-100 h-100 rounded-start" style="min-height:220px;">
                                        <i class="bi bi-image fs-1"></i>
                                    </div>
                                }
                            </div>

                            <div class="col-12 col-md-8">
                                <div class="card-body d-flex flex-column h-100 text-center text-md-start p-4">
                                    <h4 class="card-title">@item.Tytul</h4>
                                    <p class="card-text mb-3 flex-grow-1">@item.Tresc</p>
                                    <a asp-controller="Aktualnosc" asp-action="Details" asp-route-id="@item.IdAktualnosci" class="btn btn-primary btn-lg d-inline-flex align-items-center justify-content-center gap-2 mt-auto align-self-center align-self-md-start">
                                        <i class="bi bi-eye"></i>
                                        Czytaj wiecej
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-light border shadow-sm mb-0">
            Brak aktualnosci do wyswietlenia.
        </div>
    }
</div>
