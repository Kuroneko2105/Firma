@model Firma.Data.Data.CMS.Aktualnosc
@{
    ViewData["Title"] = "Aktualnosc";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4 px-4">
    <div class="card bg-body-tertiary shadow-sm">
        <div class="card-body p-4">
            <div class="row g-4 align-items-center">
                <div class="col-12 col-lg-5 d-flex align-items-center justify-content-center">
                    @if (!string.IsNullOrWhiteSpace(Model.ZdjecieUrl))
                    {
                        <img src="~/content/@Model.ZdjecieUrl" alt="@Model.Tytul" class="img-fluid rounded w-100" style="max-height:520px; object-fit:cover;" />
                    }
                    else
                    {
                        <div class="bg-secondary text-white d-flex align-items-center justify-content-center rounded w-100" style="height:260px;">
                            <i class="bi bi-image fs-1"></i>
                        </div>
                    }
                </div>
                <div class="col-12 col-lg-7">
                    <h2 class="mb-2">@Model.Tytul</h2>
                    <p class="mb-1">Link: <strong>@Model.LinkTytul</strong></p>
                    <p class="mb-3">Pozycja: <strong>@Model.Pozycja</strong></p>

                    <hr />

                    <h6>Tresc</h6>
                    <p>@Html.Raw(Model.Tresc)</p>

                    <a asp-controller="Aktualnosc" asp-action="Index" class="btn btn-outline-secondary mt-3 d-inline-flex align-items-center gap-2">
                        <i class="bi bi-arrow-left"></i>
                        Powrot do listy
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
