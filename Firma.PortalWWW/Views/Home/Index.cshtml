@using Firma.Data.Data.CMS
@using System.Linq
@model Firma.Data.Data.CMS.Strona
@{
    ViewData["Title"] = @Model.LinkTytul;
    var ogloszenia = (ViewBag.ModelOgloszenia as IEnumerable<Ogloszenie> ?? Enumerable.Empty<Ogloszenie>()).ToList();
}
@if (ogloszenia.Any())
{
    <div id="carouselExampleAutoplaying" class="carousel slide w-100" data-bs-ride="carousel">
        <div class="carousel-inner">
            @for (var i = 0; i < ogloszenia.Count; i++)
            {
                var item = ogloszenia[i];
                var zdjecie = item.ZdjecieUrl ?? "";
                var imageSrc = zdjecie.StartsWith("http://", System.StringComparison.OrdinalIgnoreCase)
                    || zdjecie.StartsWith("https://", System.StringComparison.OrdinalIgnoreCase)
                    || zdjecie.StartsWith("/")
                        ? zdjecie
                        : Url.Content($"~/content/{zdjecie.TrimStart('~', '/')}");
                var opis = item.Tresc.Length > 160 ? item.Tresc.Substring(0, 157) + "..." : item.Tresc;

                <div class="carousel-item @(i == 0 ? "active" : "")">
                    <img src="@imageSrc" class="carousel-image d-block w-100 object-fit-cover" alt="@item.Tytul">
                    <div class="carousel-caption start-0 end-0 mx-3 mx-sm-5 mb-3 p-3 p-sm-4 text-start text-white bg-dark bg-opacity-75 rounded shadow">
                        <h2 class="mb-2 text-white">@item.Tytul</h2>
                        <p class="mb-0 text-white">@opis</p>
                    </div>
                </div>
            }
        </div>
        @if (ogloszenia.Count > 1)
        {
            <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleAutoplaying" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleAutoplaying" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>
        }
    </div>
}
else
{
    <div class="alert alert-info" role="alert">
        Brak ogłoszeń ze zdjęciem do wyświetlenia w karuzeli.
    </div>
}
