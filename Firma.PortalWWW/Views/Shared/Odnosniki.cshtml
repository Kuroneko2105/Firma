@model IEnumerable<Firma.Data.Data.CMS.Strona>
@if (Model != null)
{
    foreach (var item in Model)
    {
        var linkLower = (item.LinkTytul ?? string.Empty).ToLowerInvariant();
        var titleLower = (item.Tytul ?? string.Empty).ToLowerInvariant();

        if (linkLower.Contains("aktual") || titleLower.Contains("aktual"))
        {
            <li class="nav-item">
                <a class="nav-link" asp-controller="Aktualnosc" asp-action="Index">@item.LinkTytul</a>
            </li>
        }
        else if (linkLower.Contains("sklep") || titleLower.Contains("sklep"))
        {
            <li class="nav-item">
                <a class="nav-link" asp-controller="Sklep" asp-action="Index">@item.LinkTytul</a>
            </li>
        }
        else if (linkLower.Contains("kontakt") || titleLower.Contains("kontakt"))
        {
            <li class="nav-item">
                <a class="nav-link" asp-controller="Kontakt" asp-action="Index">@item.LinkTytul</a>
            </li>
        }
        else
        {
            <li class="nav-item">
                <a class="nav-link" asp-controller="Home" asp-action="Index" asp-route-id="@item.IdStrony">@item.LinkTytul</a>
            </li>
        }
    }
}
