@model Firma.Data.Data.Sklep.Towar
@{
    ViewData["Title"] = "Szczegoly";
    Layout = "~/Views/Shared/_SklepLayout.cshtml";
    var opinie = ViewBag.Opinie as IEnumerable<Firma.Data.Data.Uzytkownicy.OpiniaKlienta> ?? Enumerable.Empty<Firma.Data.Data.Uzytkownicy.OpiniaKlienta>();
}
<div class="w-100 d-flex flex-column align-items-center">
<div class="card product-detail-card bg-body-tertiary shadow-sm w-100">
    <div class="card-body p-3 p-md-4 p-xl-5">
        <div class="row g-4 g-xl-5 align-items-stretch">
            <div class="col-12 col-lg-7">
                @if (!string.IsNullOrEmpty(Model?.FotoUrl))
                {
                    <img src="~/content/@Model.FotoUrl" alt="@Model.Nazwa" class="product-detail-image d-block w-100 object-fit-cover rounded" />
                }
                else
                {
                    <div class="product-detail-placeholder bg-secondary text-white d-flex align-items-center justify-content-center rounded">
                        <i class="bi bi-image fs-1"></i>
                    </div>
                }
            </div>
            <div class="col-12 col-lg-5 d-flex">
                <div class="d-flex flex-column justify-content-center w-100 h-100">
                    <h1 class="mb-3">@Model.Nazwa</h1>
                <p class="mb-1">Kod: <strong>@Model.Kod</strong></p>
                    <p class="display-4 text-primary mb-4">@string.Format("{0:F2}", Model.Cena) zł</p>

                <hr />

                <h6>Opis</h6>
                    <p class="lead lh-lg">@Model.Opis</p>

                    <div class="d-flex flex-column flex-sm-row gap-2 mt-4">
                        <form asp-controller="Koszyk" asp-action="Dodaj" method="post">
                            <input type="hidden" name="id" value="@Model.IdTowaru" />
                            <button type="submit" class="btn btn-success btn-lg d-inline-flex align-items-center justify-content-center gap-2 w-100">
                                <i class="bi bi-cart-plus"></i>
                                Dodaj do koszyka
                            </button>
                        </form>
                        <a asp-controller="Sklep" asp-action="Index" class="btn btn-outline-secondary btn-lg d-inline-flex align-items-center justify-content-center gap-2">
                            <i class="bi bi-arrow-left"></i>
                            Wróć do sklepu
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card product-detail-card bg-body-tertiary shadow-sm mt-4 w-100">
    <div class="card-body p-3 p-md-4">
        <h2 class="h4 mb-3">Opinie o produkcie</h2>

        @if (!opinie.Any())
        {
            <p class="text-muted mb-0">Ten produkt nie ma jeszcze zatwierdzonych opinii.</p>
        }
        else
        {
            <div class="d-flex flex-column gap-3">
                @foreach (var opinia in opinie.OrderByDescending(o => o.DataDodania))
                {
                    <div class="border rounded p-3 bg-body">
                        <div class="d-flex justify-content-between align-items-start gap-3 mb-2">
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <strong>@opinia.Imie</strong>
                                <small class="text-muted">@opinia.DataDodania.ToString("dd.MM.yyyy")</small>
                            </div>
                            <span class="badge text-bg-warning">@opinia.Ocena / 5</span>
                        </div>
                        <p class="mb-1">@opinia.Tresc</p>
                    </div>
                }
            </div>
        }
    </div>
</div>
</div>
